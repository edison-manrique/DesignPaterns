{
  "name": "design-patterns-typescript",
  "version": "1.0.0",
  "description": "Colección completa de Patrones de Diseño implementados en TypeScript con ejemplos claros y detallados",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "run:singleton": "ts-node \"./01. Creacionales/01. Singleton/01.singleton.ts\"",
    "run:factory": "ts-node \"./01. Creacionales/02. Factory/01.factory.ts\"",
    "run:abstract-factory": "ts-node \"./01. Creacionales/03. Abstract Factory/01.abstractFactory.ts\"",
    "run:builder": "ts-node \"./01. Creacionales/04. Builder/01.builder.ts\"",
    "run:prototype": "ts-node \"./01. Creacionales/05. Prototype/01.prototype.ts\"",
    "run:adapter": "ts-node \"./02. Estructurales/01. Adapter/01.adapter.ts\"",
    "run:bridge": "ts-node \"./02. Estructurales/02. Bridge/01.bridge.ts\"",
    "run:composite": "ts-node \"./02. Estructurales/03. Composite/01.composite.ts\"",
    "run:decorator": "ts-node \"./02. Estructurales/04. Decorator/01.decorator.ts\"",
    "run:facade": "ts-node \"./02. Estructurales/05. Facade/01.facade.ts\"",
    "run:flyweight": "ts-node \"./02. Estructurales/06. Flyweight/01.flyweight.ts\"",
    "run:proxy": "ts-node \"./02. Estructurales/07. Proxy/01.proxy.ts\"",
    "run:chain": "ts-node \"./03. Comportamiento/01. Chain of Responsibility/01.chainOfResponsibility.ts\"",
    "run:command": "ts-node \"./03. Comportamiento/02. Command/01.command.ts\"",
    "run:interpreter": "ts-node \"./03. Comportamiento/03. Interpreter/01.interpreter.ts\"",
    "run:iterator": "ts-node \"./03. Comportamiento/04. Iterator/01.iterator.ts\"",
    "run:mediator": "ts-node \"./03. Comportamiento/05. Mediator/01.mediator.ts\"",
    "run:memento": "ts-node \"./03. Comportamiento/06. Memento/01.memento.ts\"",
    "run:observer": "ts-node \"./03. Comportamiento/07. Observer/01.observer.ts\"",
    "run:state": "ts-node \"./03. Comportamiento/08. State/01.state.ts\"",
    "run:strategy": "ts-node \"./03. Comportamiento/09. Strategy/01.strategy.ts\"",
    "run:template": "ts-node \"./03. Comportamiento/10. Template Method/01.templateMethod.ts\"",
    "run:visitor": "ts-node \"./03. Comportamiento/11. Visitor/01.visitor.ts\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "design-patterns",
    "typescript",
    "singleton",
    "factory",
    "observer",
    "strategy",
    "decorator",
    "software-architecture"
  ],
  "author": "Edison Manrique",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
