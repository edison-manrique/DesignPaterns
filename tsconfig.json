{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "types": ["node"],
    "isolatedModules": true
  },
  "include": [
    "01. Creacionales/01. Singleton/*.ts",
    "01. Creacionales/02. Factory/*.ts",
    "01. Creacionales/03. Abstract Factory/*.ts",
    "01. Creacionales/04. Builder/*.ts",
    "01. Creacionales/05. Prototype/*.ts",
    "02. Estructurales/01. Adapter/*.ts",
    "02. Estructurales/02. Bridge/*.ts",
    "02. Estructurales/03. Composite/*.ts",
    "02. Estructurales/04. Decorator/*.ts",
    "02. Estructurales/05. Facade/*.ts",
    "02. Estructurales/06. Flyweight/*.ts",
    "02. Estructurales/07. Proxy/*.ts",
    "03. Comportamiento/01. Chain of Responsibility/*.ts",
    "03. Comportamiento/02. Command/*.ts",
    "03. Comportamiento/03. Interpreter/*.ts",
    "03. Comportamiento/04. Iterator/*.ts",
    "03. Comportamiento/05. Mediator/*.ts",
    "03. Comportamiento/06. Memento/*.ts",
    "03. Comportamiento/07. Observer/*.ts",
    "03. Comportamiento/08. State/*.ts",
    "03. Comportamiento/09. Strategy/*.ts",
    "03. Comportamiento/10. Template Method/*.ts",
    "03. Comportamiento/11. Visitor/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
